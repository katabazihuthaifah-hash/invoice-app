<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >
  <meta name="color-scheme" content="light dark">

  <link
    rel="manifest"
    href="manifest.webmanifest"
  >

  <title>Invoice App</title>

  <style>
    :root {
      color-scheme: light;
      --page-bg: #f1f5f9;
      --card-bg: #ffffff;
      --text: #1e293b;
      --muted: #64748b;
      --border: #cbd5e1;
      --filter-bg: #e0f2fe;
      --signature-bg: #f8fafc;
    }

    body.dark {
      color-scheme: dark;
      --page-bg: #0f172a;
      --card-bg: #1e293b;
      --text: #f8fafc;
      --muted: #cbd5e1;
      --border: #475569;
      --filter-bg: #164e63;
      --signature-bg: #334155;
    }

    * {
      box-sizing: border-box;
    }

    body {
      font-family: Arial, sans-serif;
      padding: 20px;
      margin: 0;
      background: var(--page-bg);
      color: var(--text);
    }

    h1,
    h2,
    h3 {
      color: var(--text);
    }

    input,
    textarea,
    select,
    button {
      width: 100%;
      padding: 12px;
      margin: 6px 0;
      font-size: 16px;
      border-radius: 6px;
    }

    input,
    textarea,
    select {
      border: 1px solid var(--border);
      background: var(--card-bg);
      color: var(--text);
    }

    textarea {
      min-height: 80px;
      resize: vertical;
    }

    button {
      border: 0;
      background: #2563eb;
      color: white;
    }

    button:active {
      opacity: 0.8;
    }

    .edit-button {
      background: #059669;
    }

    .delete-button {
      background: #dc2626;
    }

    .payment-button {
      background: #d97706;
    }

    .cancel-button {
      background: #6b7280;
    }

    .print-button {
      background: #7c3aed;
    }

    .save-business-button {
      background: #0891b2;
    }

    .signature-button {
      background: #475569;
    }

    .repair-button {
      background: #be123c;
    }

    .export-button {
      background: #16a34a;
    }

    .import-button {
      background: #9333ea;
    }

    .theme-button {
      background: #111827;
    }

    .reminder-button {
      background: #ea580c;
    }

    .install-button {
      background: #0f766e;
    }

    .remove-logo-button {
      background: #dc2626;
    }

    body.dark .theme-button {
      background: #f8fafc;
      color: #111827;
    }

    article,
    .dashboard-card,
    .business-card,
    .signature-card,
    details,
    .reminder-box {
      background: var(--card-bg);
      color: var(--text);
      padding: 16px;
      margin-top: 12px;
      border-radius: 8px;
      box-shadow: 0 2px 5px #00000020;
    }

    .business-card {
      border-left: 5px solid #2563eb;
    }

    .business-card h1 {
      margin: 0;
    }

    .business-card p {
      margin: 5px 0;
      color: var(--muted);
    }

    .business-logo {
      display: block;
      max-width: 180px;
      max-height: 100px;
      object-fit: contain;
      margin-bottom: 12px;
      background: white;
      border: 1px solid var(--border);
      border-radius: 6px;
    }

    details {
      border-left: 5px solid #0891b2;
    }

    summary {
      cursor: pointer;
      font-weight: bold;
      font-size: 18px;
      color: var(--text);
      padding: 4px 0;
    }

    details[open] summary {
      margin-bottom: 12px;
    }

    .dashboard {
      display: grid;
      grid-template-columns:
        repeat(auto-fit, minmax(160px, 1fr));
      gap: 12px;
      margin-bottom: 20px;
    }

    .dashboard-card {
      margin-top: 0;
      text-align: center;
    }

    .dashboard-card p {
      margin: 5px 0;
      color: var(--muted);
    }

    .dashboard-card strong {
      font-size: 20px;
      color: var(--text);
    }

    #message {
      color: #2563eb;
      font-weight: bold;
    }

    #reminderMessage {
      color: #ea580c;
      font-weight: bold;
    }

    #paymentBox {
      background: #fef3c7;
      color: #92400e;
      padding: 15px;
      margin-top: 15px;
      border-radius: 8px;
    }

    body.dark #paymentBox {
      background: #713f12;
      color: #fef3c7;
    }

    .reminder-box {
      background: #fee2e2;
      border-left: 5px solid #dc2626;
      color: #991b1b;
    }

    body.dark .reminder-box {
      background: #7f1d1d;
      color: #fee2e2;
    }

    .signature-card {
      background: var(--signature-bg);
    }

    #signatureCanvas {
      width: 100%;
      height: 180px;
      background: white;
      border: 2px dashed #94a3b8;
      border-radius: 6px;
      touch-action: none;
    }

    .signature-preview {
      width: 100%;
      max-height: 120px;
      object-fit: contain;
      background: white;
      border: 1px solid var(--border);
      margin-top: 10px;
    }

    .invoice-notes {
      white-space: pre-wrap;
      margin-top: 10px;
      padding: 10px;
      background: var(--signature-bg);
      border-left: 3px solid #64748b;
      color: var(--text);
    }

    .payment-history {
      margin-top: 12px;
      padding: 10px;
      background: var(--signature-bg);
      border-radius: 6px;
    }

    .payment-history table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 8px;
    }

    .payment-history th,
    .payment-history td {
      padding: 8px;
      text-align: left;
      border-bottom: 1px solid var(--border);
      font-size: 14px;
    }

    .status {
      display: inline-block;
      padding: 5px 9px;
      margin-top: 10px;
      border-radius: 12px;
      font-weight: bold;
      font-size: 13px;
    }

    .paid {
      background: #dcfce7;
      color: #166534;
    }

    .pending {
      background: #fef3c7;
      color: #92400e;
    }

    .overdue {
      background: #fee2e2;
      color: #991b1b;
    }

    .empty-message {
      color: var(--muted);
    }

    .filter-box {
      background: var(--filter-bg);
      padding: 15px;
      border-radius: 8px;
    }

    #importFile,
    #logoFile {
      display: none;
    }

    dialog {
      width: min(90%, 400px);
      border: 0;
      border-radius: 10px;
      padding: 20px;
      background: var(--card-bg);
      color: var(--text);
      box-shadow: 0 10px 30px #00000050;
    }

    dialog::backdrop {
      background: #00000080;
    }

    @media (min-width: 800px) {
      body {
        max-width: 1100px;
        margin: 0 auto;
      }

      #invoiceList {
        display: grid;
        grid-template-columns:
          repeat(auto-fit, minmax(300px, 1fr));
        gap: 16px;
      }

      article {
        margin-top: 0;
      }
    }

    @media (max-width: 480px) {
      body {
        padding: 12px;
      }

      h1 {
        font-size: 26px;
      }

      h2 {
        font-size: 21px;
      }

      h3 {
        font-size: 18px;
      }

      .dashboard {
        grid-template-columns: 1fr 1fr;
        gap: 8px;
      }

      .dashboard-card {
        padding: 12px 8px;
      }

      .dashboard-card strong {
        font-size: 16px;
      }

      article,
      .business-card,
      .signature-card,
      details,
      .reminder-box {
        padding: 12px;
      }

      .payment-history {
        overflow-x: auto;
      }

      .payment-history table {
        min-width: 320px;
      }
    }

    @media print {
      body {
        background: white;
        color: black;
        padding: 0;
      }

      .no-print,
      button,
      input,
      textarea,
      select,
      #message,
      #reminderMessage,
      #paymentBox,
      details,
      .reminder-box,
      dialog {
        display: none !important;
      }

      .business-card,
      .dashboard-card,
      article {
        background: white;
        color: black;
        box-shadow: none;
        border: 1px solid #cccccc;
        break-inside: avoid;
      }

      .business-logo {
        border-color: #cccccc;
      }

      .invoice-notes,
      .payment-history {
        background: white;
        color: black;
      }

      .payment-history th,
      .payment-history td {
        color: black;
        border-color: #cccccc;
      }

      .business-card h1,
      .business-card p,
      .dashboard-card p,
      .dashboard-card strong,
      h1,
      h2,
      h3 {
        color: black;
      }

      .signature-preview {
        max-width: 280px;
      }

      h1 {
        text-align: center;
      }
    }
  </style>
</head>

<body>
  <div class="no-print">
    <h1>Invoice App</h1>

    <button
      id="themeButton"
      class="theme-button"
      type="button"
    >
      Switch to dark mode
    </button>

    <button
      id="installButton"
      class="install-button"
      type="button"
      hidden
    >
      Install invoice app
    </button>

    <button
      id="reminderButton"
      class="reminder-button"
      type="button"
    >
      Enable overdue reminders
    </button>

    <div id="reminderMessage"></div>

    <details>
      <summary>Business details</summary>

      <input
        id="businessName"
        type="text"
        placeholder="Business name"
      >

      <input
        id="businessPhone"
        type="tel"
        placeholder="Phone number"
      >

      <input
        id="businessEmail"
        type="email"
        placeholder="Email address"
      >

      <textarea
        id="businessAddress"
        placeholder="Business address"
      ></textarea>

      <label for="currencySelect">
        Currency
      </label>

      <select id="currencySelect">
        <option value="KES">
          KES - Kenyan Shilling
        </option>

        <option value="USD">
          USD - US Dollar
        </option>

        <option value="EUR">
          EUR - Euro
        </option>

        <option value="GBP">
          GBP - Pound Sterling
        </option>

        <option value="TZS">
          TZS - Tanzanian Shilling
        </option>
      </select>

      <label for="dateFormatSelect">
        Date format
      </label>

      <select id="dateFormatSelect">
        <option value="DMY">
          DD/MM/YYYY
        </option>

        <option value="MDY">
          MM/DD/YYYY
        </option>

        <option value="YMD">
          YYYY-MM-DD
        </option>
      </select>

      <button
        id="logoButton"
        class="save-business-button"
        type="button"
      >
        Choose business logo
      </button>

      <input
        id="logoFile"
        type="file"
        accept="image/png,image/jpeg,image/webp"
      >

      <button
        id="removeLogoButton"
        class="remove-logo-button"
        type="button"
      >
        Remove business logo
      </button>

      <button
        id="saveBusinessButton"
        class="save-business-button"
        type="button"
      >
        Save business details
      </button>
    </details>
  </div>

  <div class="business-card">
    <img
      id="displayBusinessLogo"
      class="business-logo"
      alt="Business logo"
      hidden
    >

    <h1 id="displayBusinessName">
      Your Business Name
    </h1>

    <p id="displayBusinessPhone">
      Phone: Not provided
    </p>

    <p id="displayBusinessEmail">
      Email: Not provided
    </p>

    <p id="displayBusinessAddress">
      Address: Not provided
    </p>

    <p id="displayCurrency">
      Currency: KES
    </p>

    <p id="displayDateFormat">
      Date format: DD/MM/YYYY
    </p>
  </div>

  <div id="reminderBox" hidden></div>

  <h2>Dashboard</h2>

  <div class="dashboard">
    <div class="dashboard-card">
      <p>Invoices</p>
      <strong id="totalInvoices">0</strong>
    </div>

    <div class="dashboard-card">
      <p>Total billed</p>
      <strong id="totalBilled">KES 0.00</strong>
    </div>

    <div class="dashboard-card">
      <p>Total paid</p>
      <strong id="totalPaid">KES 0.00</strong>
    </div>

    <div class="dashboard-card">
      <p>Outstanding</p>
      <strong id="totalOutstanding">KES 0.00</strong>
    </div>
  </div>

  <div class="no-print">
    <details open>
      <summary>Search and filter invoices</summary>

      <div class="filter-box">
        <input
          id="searchInput"
          type="search"
          placeholder="Search customer or invoice number"
        >

        <select id="statusFilter">
          <option value="all">All statuses</option>
          <option value="paid">Paid</option>
          <option value="pending">Pending</option>
          <option value="overdue">Overdue</option>
        </select>

        <select id="sortFilter">
          <option value="newest">Newest first</option>
          <option value="oldest">Oldest first</option>
          <option value="amountHigh">
            Highest amount
          </option>
          <option value="amountLow">
            Lowest amount
          </option>
        </select>
      </div>
    </details>

    <details open>
      <summary>Add invoice</summary>

      <input
        id="customer"
        list="customerSuggestions"
        type="text"
        placeholder="Customer name"
        minlength="2"
        maxlength="100"
        required
      >

      <datalist id="customerSuggestions"></datalist>

      <input
        id="amount"
        type="number"
        placeholder="Amount"
        min="0.01"
        step="0.01"
        required
      >

      <input
        id="dueDate"
        type="date"
        required
      >

      <textarea
        id="notes"
        maxlength="1000"
        placeholder="Invoice notes or description (optional)"
      ></textarea>

      <div class="signature-card">
        <h3>Customer signature</h3>

        <canvas id="signatureCanvas"></canvas>

        <button
          id="clearSignatureButton"
          class="signature-button"
          type="button"
        >
          Clear signature
        </button>
      </div>

      <button id="saveButton" type="button">
        Save invoice
      </button>

      <button
        id="cancelButton"
        class="cancel-button"
        type="button"
        hidden
      >
        Cancel edit
      </button>

      <p id="message"></p>

      <div id="paymentBox" hidden>
        <h3>Record payment</h3>

        <p id="paymentBalance"></p>

        <input
          id="paymentAmount"
          type="number"
          placeholder="Payment amount"
          min="0.01"
          step="0.01"
        >

        <button
          id="confirmPaymentButton"
          type="button"
        >
          Confirm payment
        </button>

        <button
          id="cancelPaymentButton"
          class="cancel-button"
          type="button"
        >
          Cancel payment
        </button>
      </div>
    </details>

    <details>
      <summary>Backup and reports</summary>

      <button
        id="printButton"
        class="print-button"
        type="button"
      >
        Print report / Save as PDF
      </button>

      <button
        id="exportButton"
        class="export-button"
        type="button"
      >
        Export backup file
      </button>

      <button
        id="importButton"
        class="import-button"
        type="button"
      >
        Import backup file
      </button>

      <input
        id="importFile"
        type="file"
        accept=".json,application/json"
      >

      <button
        id="repairNumbersButton"
        class="repair-button"
        type="button"
      >
        Repair invoice numbers
      </button>
    </details>
  </div>

  <dialog
    id="deleteDialog"
    aria-labelledby="deleteDialogTitle"
  >
    <h2 id="deleteDialogTitle">
      Delete invoice?
    </h2>

    <p id="deleteDialogMessage"></p>

    <button
      id="cancelDeleteButton"
      class="cancel-button"
      type="button"
    >
      Cancel
    </button>

    <button
      id="confirmDeleteButton"
      class="delete-button"
      type="button"
    >
      Delete invoice
    </button>
  </dialog>

  <h2>Invoices</h2>

  <div id="invoiceList"></div>

  <script>
    var invoices = [];
    var business = defaultBusiness();

    var editingIndex = -1;
    var paymentIndex = -1;
    var deleteIndex = -1;
    var isDrawing = false;
    var installPrompt = null;

    var canvas =
      document.getElementById("signatureCanvas");

    var context =
      canvas.getContext("2d");

    var saveButton =
      document.getElementById("saveButton");

    var cancelButton =
      document.getElementById("cancelButton");

    var message =
      document.getElementById("message");

    var list =
      document.getElementById("invoiceList");

    var paymentBox =
      document.getElementById("paymentBox");

    var paymentBalance =
      document.getElementById("paymentBalance");

    var paymentAmount =
      document.getElementById("paymentAmount");

    var confirmPaymentButton =
      document.getElementById(
        "confirmPaymentButton"
      );

    var cancelPaymentButton =
      document.getElementById(
        "cancelPaymentButton"
      );

    var searchInput =
      document.getElementById("searchInput");

    var statusFilter =
      document.getElementById("statusFilter");

    var sortFilter =
      document.getElementById("sortFilter");

    var printButton =
      document.getElementById("printButton");

    var exportButton =
      document.getElementById("exportButton");

    var importButton =
      document.getElementById("importButton");

    var importFile =
      document.getElementById("importFile");

    var repairNumbersButton =
      document.getElementById(
        "repairNumbersButton"
      );

    var themeButton =
      document.getElementById("themeButton");

    var installButton =
      document.getElementById("installButton");

    var reminderButton =
      document.getElementById(
        "reminderButton"
      );

    var reminderMessage =
      document.getElementById(
        "reminderMessage"
      );

    var reminderBox =
      document.getElementById(
        "reminderBox"
      );

    var saveBusinessButton =
      document.getElementById(
        "saveBusinessButton"
      );

    var logoButton =
      document.getElementById("logoButton");

    var logoFile =
      document.getElementById("logoFile");

    var removeLogoButton =
      document.getElementById(
        "removeLogoButton"
      );

    var displayBusinessLogo =
      document.getElementById(
        "displayBusinessLogo"
      );

    var clearSignatureButton =
      document.getElementById(
        "clearSignatureButton"
      );

    var currencySelect =
      document.getElementById(
        "currencySelect"
      );

    var dateFormatSelect =
      document.getElementById(
        "dateFormatSelect"
      );

    var notesInput =
      document.getElementById("notes");

    var customerSuggestions =
      document.getElementById(
        "customerSuggestions"
      );

    var deleteDialog =
      document.getElementById("deleteDialog");

    var deleteDialogMessage =
      document.getElementById(
        "deleteDialogMessage"
      );

    var cancelDeleteButton =
      document.getElementById(
        "cancelDeleteButton"
      );

    var confirmDeleteButton =
      document.getElementById(
        "confirmDeleteButton"
      );

    function defaultBusiness() {
      return {
        name: "",
        phone: "",
        email: "",
        address: "",
        currency: "KES",
        logo: "",
        dateFormat: "DMY"
      };
    }

    function safeJson(value, fallback) {
      try {
        return JSON.parse(value);
      } catch (error) {
        return fallback;
      }
    }

    function loadLegacyData() {
      var oldInvoices =
        safeJson(
          localStorage.getItem(
            "invoiceAppInvoices"
          ),
          []
        );

      var oldBusiness =
        safeJson(
          localStorage.getItem(
            "invoiceAppBusiness"
          ),
          defaultBusiness()
        );

      if (!Array.isArray(oldInvoices)) {
        oldInvoices = [];
      }

      if (
        !oldBusiness ||
        typeof oldBusiness !== "object"
      ) {
        oldBusiness =
          defaultBusiness();
      }

      oldBusiness.currency =
        oldBusiness.currency || "KES";

      oldBusiness.logo =
        oldBusiness.logo || "";

      oldBusiness.dateFormat =
        oldBusiness.dateFormat || "DMY";

      return {
        invoices: oldInvoices,
        business: oldBusiness
      };
    }

    function openDatabase() {
      return new Promise(function (resolve, reject) {
        if (!("indexedDB" in window)) {
          reject(
            new Error(
              "IndexedDB is not supported."
            )
          );

          return;
        }

        var request =
          indexedDB.open(
            "InvoiceAppDatabase",
            1
          );

        request.onupgradeneeded =
          function (event) {
            var database =
              event.target.result;

            if (
              !database.objectStoreNames
                .contains("appData")
            ) {
              database.createObjectStore(
                "appData"
              );
            }
          };

        request.onsuccess =
          function () {
            resolve(request.result);
          };

        request.onerror =
          function () {
            reject(request.error);
          };
      });
    }

    function readDatabase(database, key) {
      return new Promise(function (resolve, reject) {
        var transaction =
          database.transaction(
            "appData",
            "readonly"
          );

        var store =
          transaction.objectStore("appData");

        var request =
          store.get(key);

        request.onsuccess =
          function () {
            resolve(request.result);
          };

        request.onerror =
          function () {
            reject(request.error);
          };
      });
    }

    function writeDatabase(
      database,
      key,
      value
    ) {
      return new Promise(function (resolve, reject) {
        var transaction =
          database.transaction(
            "appData",
            "readwrite"
          );

        var store =
          transaction.objectStore("appData");

        var request =
          store.put(value, key);

        request.onsuccess =
          function () {
            resolve();
          };

        request.onerror =
          function () {
            reject(request.error);
          };
      });
    }

    async function initializeStorage() {
      try {
        var database =
          await openDatabase();

        var storedInvoices =
          await readDatabase(
            database,
            "invoices"
          );

        var storedBusiness =
          await readDatabase(
            database,
            "business"
          );

        if (Array.isArray(storedInvoices)) {
          invoices =
            storedInvoices;
        }

        if (
          storedBusiness &&
          typeof storedBusiness === "object"
        ) {
          business =
            storedBusiness;
        }

        if (
          !Array.isArray(storedInvoices) &&
          !storedBusiness
        ) {
          var legacy =
            loadLegacyData();

          invoices =
            legacy.invoices;

          business =
            legacy.business;

          await writeDatabase(
            database,
            "invoices",
            invoices
          );

          await writeDatabase(
            database,
            "business",
            business
          );
        }

        business.currency =
          business.currency || "KES";

        business.logo =
          business.logo || "";

        business.dateFormat =
          business.dateFormat || "DMY";

        migratePaymentHistory();
        repairInvoiceNumbers(false);

        updateBusinessDisplay();
        updateCustomerSuggestions();
        showInvoices();
      } catch (error) {
        var legacy =
          loadLegacyData();

        invoices =
          legacy.invoices;

        business =
          legacy.business;

        migratePaymentHistory();
        repairInvoiceNumbers(false);

        updateBusinessDisplay();
        updateCustomerSuggestions();
        showInvoices();

        message.textContent =
          "Using browser storage mode.";
      }
    }

    async function saveInvoices() {
      try {
        var database =
          await openDatabase();

        await writeDatabase(
          database,
          "invoices",
          invoices
        );
      } catch (error) {
        localStorage.setItem(
          "invoiceAppInvoices",
          JSON.stringify(invoices)
        );
      }
    }

    async function saveBusiness() {
      try {
        var database =
          await openDatabase();

        await writeDatabase(
          database,
          "business",
          business
        );
      } catch (error) {
        localStorage.setItem(
          "invoiceAppBusiness",
          JSON.stringify(business)
        );
      }
    }

    async function requestPersistentStorage() {
      if (
        navigator.storage &&
        navigator.storage.persist
      ) {
        try {
          await navigator.storage.persist();
        } catch (error) {
          console.log(
            "Persistent storage request unavailable."
          );
        }
      }
    }

    function migratePaymentHistory() {
      var changed = false;

      invoices.forEach(function (invoice) {
        if (
          !Array.isArray(invoice.payments)
        ) {
          invoice.payments = [];

          var oldPaid =
            Number(invoice.paid) || 0;

          if (oldPaid > 0) {
            invoice.payments.push({
              amount: oldPaid,
              date:
                invoice.invoiceDate ||
                getLocalDate()
            });
          }

          changed = true;
        }

        if (invoice.paid === undefined) {
          invoice.paid =
            invoice.payments.reduce(
              function (total, payment) {
                return total +
                  (Number(payment.amount) || 0);
              },
              0
            );

          changed = true;
        }
      });

      if (changed) {
        saveInvoices();
      }
    }

    function updateCustomerSuggestions() {
      var names = [];

      invoices.forEach(function (invoice) {
        var name =
          String(invoice.customer || "")
            .trim();

        if (
          name !== "" &&
          names.indexOf(name) === -1
        ) {
          names.push(name);
        }
      });

      names.sort(function (a, b) {
        return a.localeCompare(b);
      });

      customerSuggestions.innerHTML = "";

      names.forEach(function (name) {
        var option =
          document.createElement("option");

        option.value = name;

        customerSuggestions.appendChild(
          option
        );
      });
    }

    function money(value) {
      var formatter =
        new Intl.NumberFormat(
          "en-KE",
          {
            style: "currency",
            currency: business.currency || "KES",
            minimumFractionDigits: 2,
            maximumFractionDigits: 2
          }
        );

      return formatter.format(
        Number(value || 0)
      );
    }

    function getLocalDate() {
      var today =
        new Date();

      var year =
        today.getFullYear();

      var month =
        String(today.getMonth() + 1)
          .padStart(2, "0");

      var day =
        String(today.getDate())
          .padStart(2, "0");

      return year + "-" + month + "-" + day;
    }

    function invoiceNumber(number) {
      return "INV-" +
        String(number).padStart(3, "0");
    }

    function repairInvoiceNumbers(shouldSave) {
      var number = 1;

      invoices.forEach(function (invoice) {
        invoice.number =
          invoiceNumber(number);

        if (!invoice.invoiceDate) {
          invoice.invoiceDate =
            getLocalDate();
        }

        if (invoice.paid === undefined) {
          invoice.paid = 0;
        }

        if (invoice.notes === undefined) {
          invoice.notes = "";
        }

        if (!Array.isArray(invoice.payments)) {
          invoice.payments = [];
        }

        number++;
      });

      if (shouldSave !== false) {
        saveInvoices();
      }
    }

    function getNextInvoiceNumber() {
      return invoiceNumber(
        invoices.length + 1
      );
    }

    function formatDate(dateValue) {
      if (!dateValue) {
        return "Not provided";
      }

      var parts =
        String(dateValue).split("-");

      if (parts.length !== 3) {
        return dateValue;
      }

      var year = parts[0];
      var month = parts[1];
      var day = parts[2];

      var selectedFormat =
        business.dateFormat || "DMY";

      if (selectedFormat === "MDY") {
        return month + "/" +
          day + "/" +
          year;
      }

      if (selectedFormat === "YMD") {
        return year + "-" +
          month + "-" +
          day;
      }

      return day + "/" +
        month + "/" +
        year;
    }

    function dateFormatLabel() {
      var selectedFormat =
        business.dateFormat || "DMY";

      if (selectedFormat === "MDY") {
        return "MM/DD/YYYY";
      }

      if (selectedFormat === "YMD") {
        return "YYYY-MM-DD";
      }

      return "DD/MM/YYYY";
    }

    function isOverdue(invoice) {
      var total =
        Number(invoice.amount) || 0;

      var paid =
        Number(invoice.paid) || 0;

      if (total - paid <= 0) {
        return false;
      }

      var today =
        new Date();

      today.setHours(0, 0, 0, 0);

      var dueDate =
        new Date(
          invoice.dueDate +
          "T00:00:00"
        );

      return dueDate < today;
    }

    function getStatus(invoice) {
      var total =
        Number(invoice.amount) || 0;

      var paid =
        Number(invoice.paid) || 0;

      if (total - paid <= 0) {
        return {
          text: "Paid",
          className: "paid"
        };
      }

      if (isOverdue(invoice)) {
        return {
          text: "Overdue",
          className: "overdue"
        };
      }

      return {
        text: "Pending",
        className: "pending"
      };
    }

    function showOverdueReminder() {
      var overdueInvoices =
        invoices.filter(function (invoice) {
          return isOverdue(invoice);
        });

      if (overdueInvoices.length === 0) {
        reminderBox.hidden = true;
        reminderBox.innerHTML = "";
        return;
      }

      var totalOutstanding = 0;

      overdueInvoices.forEach(function (invoice) {
        totalOutstanding +=
          (Number(invoice.amount) || 0) -
          (Number(invoice.paid) || 0);
      });

      reminderBox.innerHTML =
        "<strong>Overdue reminder:</strong><br>" +
        overdueInvoices.length +
        " invoice(s) are overdue.<br>" +
        "Outstanding overdue amount: " +
        money(totalOutstanding);

      reminderBox.className =
        "reminder-box";

      reminderBox.hidden = false;
    }

    function updateDashboard() {
      var totalBilled = 0;
      var totalPaid = 0;

      invoices.forEach(function (invoice) {
        totalBilled +=
          Number(invoice.amount) || 0;

        totalPaid +=
          Number(invoice.paid) || 0;
      });

      document.getElementById(
        "totalInvoices"
      ).textContent =
        invoices.length;

      document.getElementById(
        "totalBilled"
      ).textContent =
        money(totalBilled);

      document.getElementById(
        "totalPaid"
      ).textContent =
        money(totalPaid);

      document.getElementById(
        "totalOutstanding"
      ).textContent =
        money(totalBilled - totalPaid);
    }

    function updateBusinessDisplay() {
      document.getElementById(
        "businessName"
      ).value =
        business.name || "";

      document.getElementById(
        "businessPhone"
      ).value =
        business.phone || "";

      document.getElementById(
        "businessEmail"
      ).value =
        business.email || "";

      document.getElementById(
        "businessAddress"
      ).value =
        business.address || "";

      currencySelect.value =
        business.currency || "KES";

      dateFormatSelect.value =
        business.dateFormat || "DMY";

      if (business.logo) {
        displayBusinessLogo.src =
          business.logo;

        displayBusinessLogo.hidden =
          false;
      } else {
        displayBusinessLogo.removeAttribute(
          "src"
        );

        displayBusinessLogo.hidden =
          true;
      }

      document.getElementById(
        "displayBusinessName"
      ).textContent =
        business.name || "Your Business Name";

      document.getElementById(
        "displayBusinessPhone"
      ).textContent =
        "Phone: " +
        (business.phone || "Not provided");

      document.getElementById(
        "displayBusinessEmail"
      ).textContent =
        "Email: " +
        (business.email || "Not provided");

      document.getElementById(
        "displayBusinessAddress"
      ).textContent =
        "Address: " +
        (business.address || "Not provided");

      document.getElementById(
        "displayCurrency"
      ).textContent =
        "Currency: " +
        (business.currency || "KES");

      document.getElementById(
        "displayDateFormat"
      ).textContent =
        "Date format: " +
        dateFormatLabel();
    }

    function clearForm() {
      document.getElementById(
        "customer"
      ).value = "";

      document.getElementById(
        "amount"
      ).value = "";

      document.getElementById(
        "dueDate"
      ).value = "";

      notesInput.value = "";

      clearSignature();

      editingIndex = -1;

      saveButton.textContent =
        "Save invoice";

      cancelButton.hidden = true;
    }

    function closePaymentBox() {
      paymentBox.hidden = true;
      paymentIndex = -1;
      paymentAmount.value = "";
    }

    function resizeCanvas() {
      var ratio =
        Math.max(
          window.devicePixelRatio || 1,
          1
        );

      var width =
        canvas.offsetWidth;

      var height =
        canvas.offsetHeight;

      canvas.width =
        width * ratio;

      canvas.height =
        height * ratio;

      context.setTransform(
        ratio,
        0,
        0,
        ratio,
        0,
        0
      );

      context.lineWidth = 2;
      context.lineCap = "round";
      context.lineJoin = "round";
      context.strokeStyle = "#111827";
    }

    function clearSignature() {
      context.clearRect(
        0,
        0,
        canvas.width,
        canvas.height
      );
    }

    function hasSignature() {
      var pixels =
        context.getImageData(
          0,
          0,
          canvas.width,
          canvas.height
        ).data;

      for (
        var i = 3;
        i < pixels.length;
        i += 4
      ) {
        if (pixels[i] !== 0) {
          return true;
        }
      }

      return false;
    }

    function getCanvasPoint(event) {
      var rectangle =
        canvas.getBoundingClientRect();

      return {
        x: event.clientX - rectangle.left,
        y: event.clientY - rectangle.top
      };
    }

    function startDrawing(event) {
      isDrawing = true;

      canvas.setPointerCapture(
        event.pointerId
      );

      var point =
        getCanvasPoint(event);

      context.beginPath();
      context.moveTo(point.x, point.y);
    }

    function draw(event) {
      if (!isDrawing) {
        return;
      }

      var point =
        getCanvasPoint(event);

      context.lineTo(point.x, point.y);
      context.stroke();
    }

    function stopDrawing(event) {
      isDrawing = false;

      if (
        canvas.hasPointerCapture &&
        canvas.hasPointerCapture(
          event.pointerId
        )
      ) {
        canvas.releasePointerCapture(
          event.pointerId
        );
      }
    }

    function applyTheme(theme) {
      if (theme === "dark") {
        document.body.classList.add("dark");

        themeButton.textContent =
          "Switch to light mode";
      } else {
        document.body.classList.remove("dark");

        themeButton.textContent =
          "Switch to dark mode";
      }

      localStorage.setItem(
        "invoiceAppTheme",
        theme
      );
    }

    function loadTheme() {
      var savedTheme =
        localStorage.getItem(
          "invoiceAppTheme"
        );

      if (
        savedTheme !== "dark" &&
        savedTheme !== "light"
      ) {
        savedTheme = "light";
      }

      applyTheme(savedTheme);
    }

    function visibleInvoices() {
      var searchText =
        searchInput.value
          .trim()
          .toLowerCase();

      var selectedStatus =
        statusFilter.value;

      var selectedSort =
        sortFilter.value;

      var result =
        invoices.filter(function (invoice) {
          var customer =
            String(invoice.customer)
              .toLowerCase();

          var number =
            String(invoice.number)
              .toLowerCase();

          var status =
            getStatus(invoice);

          var matchesSearch =
            customer.includes(searchText) ||
            number.includes(searchText);

          var matchesStatus =
            selectedStatus === "all" ||
            status.className ===
            selectedStatus;

          return matchesSearch &&
            matchesStatus;
        });

      result.sort(function (a, b) {
        if (selectedSort === "amountHigh") {
          return Number(b.amount) -
            Number(a.amount);
        }

        if (selectedSort === "amountLow") {
          return Number(a.amount) -
            Number(b.amount);
        }

        if (selectedSort === "oldest") {
          return String(a.dueDate)
            .localeCompare(
              String(b.dueDate)
            );
        }

        return String(b.dueDate)
          .localeCompare(
            String(a.dueDate)
          );
      });

      return result;
    }

    function showInvoices() {
      list.innerHTML = "";

      var result =
        visibleInvoices();

      if (result.length === 0) {
        list.innerHTML =
          '<p class="empty-message">' +
          "No matching invoices." +
          "</p>";

        updateDashboard();
        showOverdueReminder();
        updateCustomerSuggestions();
        return;
      }

      result.forEach(function (invoice) {
        var originalIndex =
          invoices.indexOf(invoice);

        var total =
          Number(invoice.amount) || 0;

        var paid =
          Number(invoice.paid) || 0;

        var balance =
          total - paid;

        var status =
          getStatus(invoice);

        var card =
          document.createElement("article");

        card.innerHTML =
          "<strong>Invoice:</strong> " +
          invoice.number + "<br>" +

          "<strong>Customer:</strong> " +
          invoice.customer + "<br>" +

          "<strong>Invoice date:</strong> " +
          formatDate(
            invoice.invoiceDate
          ) + "<br>" +

          "<strong>Amount:</strong> " +
          money(total) + "<br>" +

          "<strong>Paid:</strong> " +
          money(paid) + "<br>" +

          "<strong>Balance:</strong> " +
          money(balance) + "<br>" +

          "<strong>Due date:</strong> " +
          formatDate(invoice.dueDate);

        if (
          invoice.notes &&
          invoice.notes.trim() !== ""
        ) {
          var notesBox =
            document.createElement("div");

          notesBox.className =
            "invoice-notes";

          notesBox.textContent =
            "Notes: " + invoice.notes;

          card.appendChild(notesBox);
        }

        var history =
          Array.isArray(invoice.payments)
            ? invoice.payments
            : [];

        if (history.length > 0) {
          var historyBox =
            document.createElement("div");

          historyBox.className =
            "payment-history";

          var historyTitle =
            document.createElement("strong");

          historyTitle.textContent =
            "Payment history";

          historyBox.appendChild(
            historyTitle
          );

          var table =
            document.createElement("table");

          table.innerHTML =
            "<thead>" +
            "<tr>" +
            "<th>Date</th>" +
            "<th>Amount</th>" +
            "</tr>" +
            "</thead>" +
            "<tbody></tbody>";

          var body =
            table.querySelector("tbody");

          history.forEach(function (payment) {
            var row =
              document.createElement("tr");

            var dateCell =
              document.createElement("td");

            dateCell.textContent =
              formatDate(payment.date);

            var amountCell =
              document.createElement("td");

            amountCell.textContent =
              money(payment.amount);

            row.appendChild(dateCell);
            row.appendChild(amountCell);
            body.appendChild(row);
          });

          historyBox.appendChild(table);
          card.appendChild(historyBox);
        }

        var statusLabel =
          document.createElement("span");

        statusLabel.className =
          "status " + status.className;

        statusLabel.textContent =
          status.text;

        card.appendChild(statusLabel);

        if (invoice.signature) {
          var signatureImage =
            document.createElement("img");

          signatureImage.className =
            "signature-preview";

          signatureImage.src =
            invoice.signature;

          signatureImage.alt =
            "Customer signature";

          card.appendChild(signatureImage);
        }

        var paymentButton =
          document.createElement("button");

        paymentButton.type = "button";
        paymentButton.className =
          "payment-button";

        paymentButton.textContent =
          "Record payment";

        paymentButton.dataset.index =
          originalIndex;

        var editButton =
          document.createElement("button");

        editButton.type = "button";
        editButton.className =
          "edit-button";

        editButton.textContent =
          "Edit";

        editButton.dataset.index =
          originalIndex;

        var deleteButton =
          document.createElement("button");

        deleteButton.type = "button";
        deleteButton.className =
          "delete-button";

        deleteButton.textContent =
          "Delete";

        deleteButton.dataset.index =
          originalIndex;

        card.appendChild(paymentButton);
        card.appendChild(editButton);
        card.appendChild(deleteButton);

        list.appendChild(card);
      });

      updateDashboard();
      showOverdueReminder();
      updateCustomerSuggestions();
    }

    function deleteInvoice() {
      if (deleteIndex === -1) {
        return;
      }

      invoices.splice(deleteIndex, 1);
      deleteIndex = -1;

      saveInvoices();
      showInvoices();

      message.textContent =
        "Invoice deleted successfully.";
    }

    saveBusinessButton.onclick =
      async function () {
        var nameInput =
          document.getElementById(
            "businessName"
          );

        var emailInput =
          document.getElementById(
            "businessEmail"
          );

        if (
          nameInput.value.trim().length < 2
        ) {
          message.textContent =
            "Enter a business name.";

          nameInput.focus();
          return;
        }

        if (
          emailInput.value.trim() !== "" &&
          !emailInput.checkValidity()
        ) {
          emailInput.reportValidity();

          message.textContent =
            "Enter a valid email address.";

          return;
        }

        business.name =
          nameInput.value.trim();

        business.phone =
          document.getElementById(
            "businessPhone"
          ).value.trim();

        business.email =
          emailInput.value.trim();

        business.address =
          document.getElementById(
            "businessAddress"
          ).value.trim();

        business.currency =
          currencySelect.value;

        business.dateFormat =
          dateFormatSelect.value;

        await saveBusiness();

        updateBusinessDisplay();
        updateDashboard();
        showInvoices();

        message.textContent =
          "Business details saved successfully.";
      };

    logoButton.onclick = function () {
      logoFile.click();
    };

    logoFile.onchange = function () {
      var selectedFile =
        logoFile.files[0];

      if (!selectedFile) {
        return;
      }

      if (
        !selectedFile.type.startsWith(
          "image/"
        )
      ) {
        message.textContent =
          "Please choose an image file.";

        logoFile.value = "";
        return;
      }

      var reader =
        new FileReader();

      reader.onload = async function () {
        business.logo =
          reader.result;

        await saveBusiness();
        updateBusinessDisplay();

        message.textContent =
          "Business logo saved successfully.";

        logoFile.value = "";
      };

      reader.onerror = function () {
        message.textContent =
          "Could not read the logo file.";

        logoFile.value = "";
      };

      reader.readAsDataURL(selectedFile);
    };

    removeLogoButton.onclick =
      async function () {
        business.logo = "";

        await saveBusiness();
        updateBusinessDisplay();

        message.textContent =
          "Business logo removed.";
      };

    saveButton.onclick =
      async function () {
        var customerInput =
          document.getElementById(
            "customer"
          );

        var amountInput =
          document.getElementById(
            "amount"
          );

        var dueDateInput =
          document.getElementById(
            "dueDate"
          );

        if (!customerInput.checkValidity()) {
          customerInput.reportValidity();

          message.textContent =
            "Enter a valid customer name.";

          return;
        }

        if (!amountInput.checkValidity()) {
          amountInput.reportValidity();

          message.textContent =
            "Enter an amount greater than zero.";

          return;
        }

        if (!dueDateInput.checkValidity()) {
          dueDateInput.reportValidity();

          message.textContent =
            "Choose an invoice due date.";

          return;
        }

        var isNew =
          editingIndex === -1;

        var invoice = {
          customer:
            customerInput.value.trim(),

          number: isNew
            ? getNextInvoiceNumber()
            : invoices[editingIndex].number,

          invoiceDate: isNew
            ? getLocalDate()
            : invoices[editingIndex]
                .invoiceDate ||
              getLocalDate(),

          amount:
            Number(amountInput.value),

          dueDate:
            dueDateInput.value,

          notes:
            notesInput.value.trim(),

          paid: 0,

          payments: isNew
            ? []
            : Array.isArray(
                invoices[editingIndex]
                  .payments
              )
              ? invoices[editingIndex]
                  .payments
              : [],

          signature:
            hasSignature()
              ? canvas.toDataURL("image/png")
              : ""
        };

        if (isNew) {
          invoices.push(invoice);

          message.textContent =
            "Invoice " +
            invoice.number +
            " saved successfully.";
        } else {
          invoice.paid =
            Number(
              invoices[editingIndex].paid
            ) || 0;

          if (!invoice.signature) {
            invoice.signature =
              invoices[editingIndex]
                .signature || "";
          }

          invoices[editingIndex] =
            invoice;

          message.textContent =
            "Invoice updated successfully.";
        }

        await saveInvoices();

        showInvoices();
        clearForm();
      };

    cancelButton.onclick = function () {
      clearForm();

      message.textContent =
        "Edit cancelled.";
    };

    clearSignatureButton.onclick =
      function () {
        clearSignature();

        message.textContent =
          "Signature cleared.";
      };

    themeButton.onclick = function () {
      var isDark =
        document.body.classList.contains(
          "dark"
        );

      applyTheme(
        isDark ? "light" : "dark"
      );
    };

    reminderButton.onclick =
      function () {
        reminderMessage.textContent =
          "On-screen overdue reminders are active.";

        showOverdueReminder();
      };

    repairNumbersButton.onclick =
      async function () {
        repairInvoiceNumbers(true);
        await saveInvoices();

        showInvoices();

        message.textContent =
          "Invoice numbers repaired successfully.";
      };

    printButton.onclick = function () {
      message.textContent =
        "Preparing print report...";

      setTimeout(function () {
        window.print();
      }, 300);
    };

    exportButton.onclick = function () {
      var backup = {
        business: business,
        invoices: invoices,
        exportedAt:
          new Date().toISOString()
      };

      var file =
        new Blob(
          [
            JSON.stringify(
              backup,
              null,
              2
            )
          ],
          {
            type: "application/json"
          }
        );

      var fileUrl =
        URL.createObjectURL(file);

      var link =
        document.createElement("a");

      link.href = fileUrl;
      link.download =
        "invoice-backup.json";

      document.body.appendChild(link);
      link.click();
      link.remove();

      URL.revokeObjectURL(fileUrl);

      message.textContent =
        "Backup downloaded successfully.";
    };

    importButton.onclick = function () {
      importFile.click();
    };

    importFile.onchange = function () {
      var selectedFile =
        importFile.files[0];

      if (!selectedFile) {
        return;
      }

      var reader =
        new FileReader();

      reader.onload = async function () {
        try {
          var importedData =
            JSON.parse(reader.result);

          if (
            !importedData ||
            !Array.isArray(
              importedData.invoices
            )
          ) {
            throw new Error(
              "Invalid backup format."
            );
          }

          if (
            !confirm(
              "Import this backup? " +
              "Current invoices will be replaced."
            )
          ) {
            importFile.value = "";
            return;
          }

          invoices =
            importedData.invoices;

          business =
            importedData.business ||
            defaultBusiness();

          business.currency =
            business.currency || "KES";

          business.logo =
            business.logo || "";

          business.dateFormat =
            business.dateFormat || "DMY";

          migratePaymentHistory();
          repairInvoiceNumbers(false);

          await saveInvoices();
          await saveBusiness();

          updateBusinessDisplay();
          showInvoices();

          message.textContent =
            "Backup imported successfully.";
        } catch (error) {
          message.textContent =
            "Could not import this backup file.";
        }

        importFile.value = "";
      };

      reader.onerror = function () {
        message.textContent =
          "Could not read the selected file.";

        importFile.value = "";
      };

      reader.readAsText(selectedFile);
    };

    list.onclick = function (event) {
      var clickedButton =
        event.target.closest("button");

      if (!clickedButton) {
        return;
      }

      var index =
        Number(clickedButton.dataset.index);

      if (
        clickedButton.className ===
        "payment-button"
      ) {
        var invoice =
          invoices[index];

        var total =
          Number(invoice.amount) || 0;

        var paid =
          Number(invoice.paid) || 0;

        var balance =
          total - paid;

        if (balance <= 0) {
          message.textContent =
            "This invoice is already fully paid.";

          return;
        }

        paymentIndex = index;

        paymentBalance.textContent =
          "Remaining balance: " +
          money(balance);

        paymentAmount.value = "";
        paymentBox.hidden = false;
        paymentAmount.focus();

        message.textContent =
          "Enter the payment amount below.";
      }

      if (
        clickedButton.className ===
        "edit-button"
      ) {
        var selected =
          invoices[index];

        document.getElementById(
          "customer"
        ).value =
          selected.customer;

        document.getElementById(
          "amount"
        ).value =
          selected.amount;

        document.getElementById(
          "dueDate"
        ).value =
          selected.dueDate;

        notesInput.value =
          selected.notes || "";

        clearSignature();

        editingIndex = index;

        saveButton.textContent =
          "Update invoice";

        cancelButton.hidden = false;

        message.textContent =
          "Change the fields, then tap Update invoice.";
      }

      if (
        clickedButton.className ===
        "delete-button"
      ) {
        var invoiceToDelete =
          invoices[index];

        deleteIndex = index;

        deleteDialogMessage.textContent =
          "Are you sure you want to delete " +
          invoiceToDelete.number +
          " for " +
          invoiceToDelete.customer +
          "?";

        if (
          typeof deleteDialog.showModal ===
          "function"
        ) {
          deleteDialog.showModal();
        } else {
          if (
            confirm(
              deleteDialogMessage.textContent
            )
          ) {
            deleteInvoice();
          } else {
            deleteIndex = -1;

            message.textContent =
              "Invoice deletion cancelled.";
          }
        }
      }
    };

    cancelDeleteButton.onclick =
      function () {
        deleteIndex = -1;
        deleteDialog.close();

        message.textContent =
          "Invoice deletion cancelled.";
      };

    confirmDeleteButton.onclick =
      function () {
        deleteDialog.close();
        deleteInvoice();
      };

    confirmPaymentButton.onclick =
      async function () {
        if (paymentIndex === -1) {
          return;
        }

        var invoice =
          invoices[paymentIndex];

        var total =
          Number(invoice.amount) || 0;

        var paid =
          Number(invoice.paid) || 0;

        var balance =
          total - paid;

        var payment =
          Number(paymentAmount.value);

        if (
          !Number.isFinite(payment) ||
          payment <= 0 ||
          payment > balance
        ) {
          message.textContent =
            "Enter a valid payment within the balance.";

          return;
        }

        if (
          !Array.isArray(invoice.payments)
        ) {
          invoice.payments = [];
        }

        invoice.payments.push({
          amount: payment,
          date: getLocalDate()
        });

        invoice.paid =
          paid + payment;

        await saveInvoices();

        closePaymentBox();
        showInvoices();

        message.textContent =
          "Payment recorded successfully.";
      };

    cancelPaymentButton.onclick =
      function () {
        closePaymentBox();

        message.textContent =
          "Payment cancelled.";
      };

    searchInput.oninput =
      showInvoices;

    statusFilter.onchange =
      showInvoices;

    sortFilter.onchange =
      showInvoices;

    window.addEventListener(
      "beforeinstallprompt",
      function (event) {
        event.preventDefault();

        installPrompt = event;
        installButton.hidden = false;
      }
    );

    installButton.onclick = function () {
      if (!installPrompt) {
        message.textContent =
          "Use the browser menu and choose Add to Home screen.";

        return;
      }

      installPrompt.prompt();

      installPrompt.userChoice
        .then(function () {
          installPrompt = null;
          installButton.hidden = true;
        })
        .catch(function () {
          installPrompt = null;
          installButton.hidden = true;
        });
    };

    window.addEventListener(
      "resize",
      resizeCanvas
    );

    canvas.addEventListener(
      "pointerdown",
      startDrawing
    );

    canvas.addEventListener(
      "pointermove",
      draw
    );

    canvas.addEventListener(
      "pointerup",
      stopDrawing
    );

    canvas.addEventListener(
      "pointercancel",
      stopDrawing
    );

    if (
      "serviceWorker" in navigator &&
      window.isSecureContext
    ) {
      window.addEventListener(
        "load",
        function () {
          navigator.serviceWorker
            .register("sw.js")
            .catch(function (error) {
              console.log(
                "Offline support unavailable.",
                error
              );
            });
        }
      );
    }

    loadTheme();
    resizeCanvas();
    requestPersistentStorage();
    initializeStorage();
  </script>
</body>
</html>
